# Sao chép tệp này thành .env trong backend và điền theo môi trường chạy.
APP_PORT=3001
# Để trống CORS_ORIGIN nếu mọi yêu cầu frontend đều đi qua Vite proxy.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

DB_NAME=BTL2_P3_DEMO

# Xác thực SQL Server qua TCP. Điền tài khoản và mật khẩu trong .env.
DB_AUTH=sql
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Khi dùng xác thực Windows cục bộ, đổi DB_AUTH thành windows
# và cấu hình đúng tên instance, ví dụ dòng dưới.
# DB_INSTANCE=localhost\YUSHINOMI
# Windows Auth cần ODBC Driver 18 for SQL Server và gói msnodesqlv8.
# Nếu SQL Server thử dùng chứng chỉ tự ký, có thể đặt DB_TRUST_SERVER_CERTIFICATE=true trong .env cục bộ.
