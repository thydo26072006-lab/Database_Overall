# Sao chép tệp này thành .env.local trong frontend, rồi khởi động lại Vite sau khi sửa.
# Để VITE_API_BASE_URL trống khi dùng proxy ở cả npm run dev và npm run preview.
VITE_API_BASE_URL=

# Đích mặc định cho các nhóm API dùng backend chung.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Bỏ dấu # ở ba dòng dưới khi chạy riêng API của Người 1, 2 và 3.
# Đặt APP_PORT=3003 cho API Người 1 và giữ cổng 3002, 3001 cho Người 2, 3.
# Để chuyển về backend chung, chú thích lại cả ba dòng.
# VITE_N1_API_TARGET=http://127.0.0.1:3003
# VITE_N2_API_TARGET=http://127.0.0.1:3002
# VITE_N3_API_TARGET=http://127.0.0.1:3001
